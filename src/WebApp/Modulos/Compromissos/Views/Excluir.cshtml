@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Compromisso";
}

@model ExcluirCompromissoViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir"
      asp-route-id="@Model.Id" method="post">

    <div class="alert alert-danger border-start border-danger border-4 rounded-3" role="alert">
        Deseja realmente excluir este compromisso?
    </div>

    <div class="mb-3">
        <label asp-for="Assunto" class="form-label fw-semibold text-primary text-uppercase small">Assunto</label>
        <input asp-for="Assunto" type="text" class="form-control" readonly>
    </div>

    <div class="mb-3">
        <label asp-for="TipoCompromissoEnum" class="form-label fw-semibold text-primary text-uppercase small">Tipo de
            Compromisso</label>
            <input asp-for="TipoCompromissoEnum" type="text" class="form-control" readonly>
        </div>

        <div class="mb-3">
            <label asp-for="Data" class="form-label fw-semibold text-primary text-uppercase small">Data</label>
            <input asp-for="Data" type="text" class="form-control" readonly>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
            <button class="btn btn-danger rounded-pill px-4" type="submit">Confirmar</button>
        </div>
    </form>
